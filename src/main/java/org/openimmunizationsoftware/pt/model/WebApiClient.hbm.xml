<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"https://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openimmunizationsoftware.pt.model">
    <class name="WebApiClient" table="web_api_client">
        <id name="clientId" type="int">
            <column name="client_id" />
            <generator class="native" />
        </id>
        <property name="apiKey" type="string">
            <column name="api_key" length="80" not-null="true" unique="true" />
        </property>
        <many-to-one name="webUser" column="web_user_id" class="WebUser" not-null="true"/>
        <property name="workspaceId" type="java.lang.Integer">
            <column name="workspace_id" />
        </property>
        <property name="agentName" type="string">
            <column name="agent_name" length="80" />
        </property>
        <property name="enabled" type="yes_no">
            <column name="enabled" length="1" not-null="true" />
        </property>
        <property name="createDate" type="timestamp">
            <column name="create_date" length="19" not-null="true" />
        </property>
        <property name="lastUsedDate" type="timestamp">
            <column name="last_used_date" length="19" />
        </property>
        <property name="clientType" type="string">
            <column name="client_type" length="10" not-null="true" />
        </property>
        <property name="deviceStatus" type="string">
            <column name="device_status" length="10" />
        </property>
        <property name="deviceName" type="string">
            <column name="device_name" length="80" />
        </property>
        <property name="approvedDate" type="timestamp">
            <column name="approved_date" length="19" />
        </property>
        <property name="revokedDate" type="timestamp">
            <column name="revoked_date" length="19" />
        </property>
    </class>
</hibernate-mapping>
