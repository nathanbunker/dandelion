<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"https://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openimmunizationsoftware.pt.model">
  <class name="Agent" table="agent">
    <id name="agentKey" type="string">
      <column name="agent_key" length="30" />
      <generator class="assigned" />
    </id>
    <property name="displayName" type="string">
      <column name="display_name" length="60" not-null="true" />
    </property>
    <property name="integrationStyle" type="string">
      <column name="integration_style" length="12" not-null="true" />
    </property>
    <property name="capabilities" type="string">
      <column name="capabilities" length="200" not-null="true" />
    </property>
    <property name="activeFlag" type="string">
      <column name="active" length="1" not-null="true" />
    </property>
    <property name="sortOrder" type="int">
      <column name="sort_order" not-null="true" />
    </property>
  </class>
</hibernate-mapping>
